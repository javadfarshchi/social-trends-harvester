        {
          "name": "Get Trending (Default)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/trending",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "trending"]
            }
          },
          "response": []
        },
        {
          "name": "Get Trending (Mock Provider)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/trending?provider=mock&region=US&count=5",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "trending"],
              "query": [
                {
                  "key": "provider",
                  "value": "mock"
                },
                {
                  "key": "region",
                  "value": "US"
                },
                {
                  "key": "count",
                  "value": "5"
                }
              ]
            }
          },
          "response": []
