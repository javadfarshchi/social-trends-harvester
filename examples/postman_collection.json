{
  "info": {
    "name": "Social Trends Harvester API",
    "description": "Platform-agnostic social media trends API with compliance features",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health & Status",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/healthz",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "healthz"]
            }
          },
          "response": []
        },
        {
          "name": "Service Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            }
          },
          "response": []
        },
        {
          "name": "List Providers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/providers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "providers"]
            }
          },
          "response": []
        },
        {
          "name": "Compliance Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/compliance",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "compliance"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Trending Content",
